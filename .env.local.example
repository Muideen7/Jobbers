# ---------------------------------------------------------------------------
# Jobbers — local environment
#
# Copy to `.env.local` and fill in every blank. Restart `npm run dev` after
# any change. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- InsForge (auth + database + storage) ----------------------------------
# REQUIRED. Without these, /login, /dashboard, /profile and /find-jobs all 500.
# The base URL is the one recorded for this project in AGENTS.md. If your
# dashboard shows a different one, change it here, in AGENTS.md and in README.md
# so the three never drift apart again.
NEXT_PUBLIC_INSFORGE_URL=
# From the InsForge dashboard > Settings > API Keys. Safe to expose to the browser.
# The SDK throws on an EMPTY value, not just a missing one, so fill this in.
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# --- Site (canonical URLs + SEO) ----------------------------------------------
# REQUIRED in production. `app/layout.tsx` builds every canonical URL,
# `og:url` and the sitemap base from this. It FALLS BACK TO
# http://localhost:3000, so a missing value silently publishes
# `og:image` / canonical links pointing at localhost on your real domain.
# No trailing slash. Local dev can leave this blank.
NEXT_PUBLIC_SITE_URL=

# --- Adzuna (live job search) ------------------------------------------------
# REQUIRED for the landing page search box and filters.
# Free keys: https://developer.adzuna.com/  (account_id + app_key)
# Without these, /api/public/jobs returns 503 "Job search is not configured yet."
# and the Live opportunities section shows the empty state.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Gemini (match scoring, resume generation, company research) -------------
# REQUIRED for the AI agent routes and resume PDF generation.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPTIONAL. Defaults to gemini-3-flash-preview; override to switch models
# (e.g. gemini-3-pro-preview) without touching code.
GEMINI_MODEL=gemini-3-flash-preview

# --- Browserbase + Stagehand (company research) ------------------------------
# OPTIONAL. Only the "Research company" button on a job detail page needs these.
# The build succeeds without them — agent/research.ts degrades to a
# job-and-profile-only dossier instead of driving a real browser.
# https://www.browserbase.com/ -> API key + Project ID
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- InsForge storage --------------------------------------------------------
# Required before uploading a resume: create a PRIVATE bucket named `resumes`
# in the InsForge dashboard (Storage). Without it, resume upload and PDF
# generation both fail.

# --- PostHog (product analytics) ---------------------------------------------
# OPTIONAL. Leave blank to disable analytics entirely; the app runs fine.
# Both must start with NEXT_PUBLIC_ so the browser bundle can read them.
# US projects use https://us.i.posthog.com — EU projects use https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- HSTS (Strict-Transport-Security) ----------------------------------------
# OPTIONAL, all three default to off/blank. See lib/security-headers.ts.
#
# The header is only ever sent on requests that arrived over TLS (gated on
# x-forwarded-proto: https), so these values are irrelevant in local dev.
#
# HSTS_MAX_AGE is in SECONDS. Defaults to 31536000 (1 year) when blank.
# Per RFC 6797, consider shipping a short max-age (e.g. 300) first, confirming
# every page loads over HTTPS, then raising it — browsers cache this value for
# the full max-age and will refuse plain HTTP until it expires.
HSTS_MAX_AGE=
# Leave blank unless EVERY subdomain is HTTPS-ready. Once a browser has seen
# includeSubDomains, an unreachable or cert-broken subdomain breaks HTTPS for
# all of them and there is no way to withdraw it before max-age expires.
HSTS_INCLUDE_SUBDOMAINS=
# Leave blank. Preloading submits your domain to browser vendors' preload list;
# removal takes months. Only set this once HSTS has shipped at max-age >= 1 year
# and stayed clean.
HSTS_PRELOAD=
