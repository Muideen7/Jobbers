# ---------------------------------------------------------------------------
# Jobbers — Local Environment Template (.env.local.example)
#
# Copy this file to `.env.local` and replace the values with your actual keys.
# Never commit `.env.local` to git.
# ---------------------------------------------------------------------------

# Site configuration
# For local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# For production (set in Vercel project environment variables):
# NEXT_PUBLIC_SITE_URL=https://jobbers-black.vercel.app
# BETTER_AUTH_URL=https://jobbers-black.vercel.app

# MongoDB connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Jobbers?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Jobbers?retryWrites=true&w=majority
MONGODB_DB=Jobbers

# Better Auth Secret (generate with `openssl rand -hex 32`)
BETTER_AUTH_SECRET=your-random-32-byte-hex-secret

# Resend email service (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Jobbers <onboarding@resend.dev>

# OAuth Social Providers (optional)
# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External API keys
# JSearch API (https://app.openwebninja.com/api/jsearch)
JSEARCH_API_KEY=

# Google Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# HSTS security headers (optional, leave blank for local dev)
HSTS_MAX_AGE=
HSTS_INCLUDE_SUBDOMAINS=
HSTS_PRELOAD=
